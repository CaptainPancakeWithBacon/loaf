#!/bin/sh
# Keep the GTK3 theme in step with Loaf's light/dark switch. GTK4/libadwaita apps follow
# color-scheme on their own; GTK3 apps only follow gtk-theme, so swap NAME <-> NAME-dark.
# loaf-gtk-theme dark|light   (does nothing if the other variant isn't installed)
case $1 in dark|light) ;; *) exit 1 ;; esac
# the login screen follows the last choice (loaf-login-scheme.path, a root unit, watches this file)
mkdir -p "$HOME/.local/state/loaf" && printf '%s\n' "$1" > "$HOME/.local/state/loaf/login-scheme"
cur=$(gsettings get org.gnome.desktop.interface gtk-theme | tr -d "'")
base=${cur%-dark}
case $1 in dark) want=$base-dark ;; light) want=$base ;; *) exit 1 ;; esac
[ "$want" = "$cur" ] && exit 0
for d in "$HOME/.local/share/themes" "$HOME/.themes" /usr/share/themes; do
    [ -d "$d/$want" ] && exec gsettings set org.gnome.desktop.interface gtk-theme "$want"
done
exit 0
