#!/bin/sh
# Switches Loaf's login screen and boot screen on or off. Runs as root, after the files are in place:
# install.sh --system and the .deb's postinst call "activate", --system-undo and the .deb's prerm "deactivate".
#   activate     login logo + Loaf login theme (light/dark) + Loaf boot screen, then rebuild the boot image
#   deactivate   back to Ubuntu's login logo, the previous login theme and Ubuntu's boot screen
#   default-session [USER]   USER (default: the first account) starts on Loaf at the next login
set -e
T=/usr/share/plymouth/themes
L=/usr/share/gnome-shell/theme/Loaf
G=/etc/gdm3/greeter.dconf-defaults
spinner="bgrt-fallback.png bullet.png capslock.png entry.png keyboard.png keymap-render.png lock.png"
initramfs() { command -v update-initramfs >/dev/null && update-initramfs -u || true; }

case $1 in
activate)
    # logo under the user list (Ubuntu's own setting, commented out by default)
    if [ -f $G ]; then
        cp -n $G $G.before-loaf
        sed -i "s|^#logo=.*|logo='/usr/share/pixmaps/loaf-login.png'|" $G
    fi
    # login theme: the active copy follows light/dark (loaf-login-scheme puts the right one in place).
    # Priority 30 wins over Ubuntu's (10) and Isobar's (25); deactivate puts the highest other one back.
    [ -f $L/gnome-shell-theme.gresource ] || cp $L/dark.gresource $L/gnome-shell-theme.gresource
    update-alternatives --install /usr/share/gnome-shell/gdm-theme.gresource gdm-theme.gresource $L/gnome-shell-theme.gresource 30
    update-alternatives --set gdm-theme.gresource $L/gnome-shell-theme.gresource
    # left over from earlier Loaf versions: a per-user path unit and the "Niri (Mist)" login entry
    systemctl disable --now loaf-login-scheme.path 2>/dev/null || true
    rm -f /etc/systemd/system/loaf-login-scheme.path /etc/systemd/system/loaf-login-scheme.service \
          /usr/share/wayland-sessions/niri-mist.desktop
    systemctl daemon-reload 2>/dev/null || true
    # boot screen: two-step like Ubuntu's own (firmware logo kept), progress bar, Loaf's watermark.
    # The password-prompt images come from Ubuntu's spinner theme.
    for f in $spinner; do [ -f $T/spinner/$f ] && cp $T/spinner/$f $T/loaf/; done
    update-alternatives --install $T/default.plymouth default.plymouth $T/loaf/loaf.plymouth 150
    update-alternatives --set default.plymouth $T/loaf/loaf.plymouth
    initramfs ;;
deactivate)
    [ -f $G ] && sed -i "s|^logo='/usr/share/pixmaps/loaf-login.png'|#logo='/usr/share/images/vendor-logos/logo-text-version-64.png'|" $G
    update-alternatives --remove gdm-theme.gresource $L/gnome-shell-theme.gresource 2>/dev/null || true
    rm -f $L/gnome-shell-theme.gresource
    update-alternatives --remove default.plymouth $T/loaf/loaf.plymouth 2>/dev/null || true
    for f in $spinner; do rm -f $T/loaf/$f; done
    initramfs ;;
default-session)
    # Start an account on Loaf at its next login: the login screen remembers each person's last session
    # in AccountsService. Used by the ISO for the account made during install (the first one, uid 1000).
    u=${2:-$(getent passwd 1000 | cut -d: -f1)}
    [ -n "$u" ] || { echo "no user given and no uid 1000" >&2; exit 1; }
    f=/var/lib/AccountsService/users/$u
    mkdir -p /var/lib/AccountsService/users
    if [ ! -f "$f" ]; then printf '[User]\nSession=loaf\nSessionType=wayland\nSystemAccount=false\n' > "$f"
    elif grep -q '^Session=' "$f"; then sed -i 's/^Session=.*/Session=loaf/' "$f"
    else sed -i '/^\[User\]/a Session=loaf' "$f"; fi ;;
*) echo "usage: loaf-system activate|deactivate|default-session [USER]" >&2; exit 1 ;;
esac
