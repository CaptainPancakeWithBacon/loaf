[Plymouth Theme]
Name=Loaf
Description=Loaf boot screen: the Framework logo from the firmware, a thin progress bar, the Loaf logo at the bottom
ModuleName=two-step

[two-step]
Font=Inter 12
TitleFont=Inter Light 24
ImageDir=/usr/share/plymouth/themes/loaf
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.7
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.7
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.93
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x000000
BackgroundEndColor=0x000000
ProgressBarBackgroundColor=0x2e2e2c
ProgressBarForegroundColor=0xececea
ProgressBarHorizontalAlignment=.5
ProgressBarVerticalAlignment=.72
ProgressBarWidth=200
ProgressBarHeight=3
DialogClearsFirmwareBackground=false
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false
UseFirmwareBackground=true
UseProgressBar=true

[shutdown]
UseEndAnimation=false
UseFirmwareBackground=true

[reboot]
UseEndAnimation=false
UseFirmwareBackground=true

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing updates
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading the system
SubTitle=Do not turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading firmware
SubTitle=Do not turn off your computer
