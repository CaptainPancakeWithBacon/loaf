// Loaf: let whoever sits at this computer (an active local session) put the light or dark login theme
// in place, by starting loaf-login-scheme@light.service or @dark.service. Only those two, only "start".
polkit.addRule(function (action, subject) {
    var unit = action.lookup("unit");
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        (unit == "loaf-login-scheme@light.service" || unit == "loaf-login-scheme@dark.service") &&
        action.lookup("verb") == "start" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
