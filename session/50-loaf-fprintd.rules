// Loaf: let whoever sits at this laptop (an active local session) restart fprintd, and nothing else.
// fprintd breaks if the laptop suspends while it is listening (the lid closes in the same second as
// the suspend); it only recovers after a restart. Loaf's lock does that after a failed finger try.
// Installed only where fprintd exists.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "fprintd.service" &&
        action.lookup("verb") == "restart" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
