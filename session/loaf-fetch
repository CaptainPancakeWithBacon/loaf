#!/usr/bin/env python3
"""loaf-fetch: the cat, and what this computer is. Ink on paper: the terminal's own colours, no accent.
The last row is Loaf's own palette. Stdlib only, reads /proc and /sys, starts nothing but `niri --version`."""
import glob, os, platform, pwd, shutil, subprocess

CAT = r"""
   ██▄      ▄██
  █████    █████
  ██████████████
  ██████████████
 ████▀▀████▀▀████
 ███▄  ▄██▄  ▄███
 ▀██████████████▀
  ▀▀██████████▀▀
       ▀▀▀▀
""".strip("\n").splitlines()
# Loaf's ground, line, faint, mute and ink (loaf/Theme.qml), light then dark
PALETTE = ["#F1EDE4", "#DED8CC", "#A09A8F", "#6E6A62", "#151515",
           "#121212", "#2E2E2C", "#5A5A57", "#A3A39E", "#ECECEA"]


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def dur(sec):
    d, rest = divmod(int(sec) // 60, 24 * 60)
    h, m = divmod(rest, 60)
    return f"{d}d {h}h" if d else f"{h}h {m:02d}m" if h else f"{m}m"


def battery():
    bat = (glob.glob("/sys/class/power_supply/BAT*") or [None])[0]
    if not bat:
        return None
    pct, status = read(f"{bat}/capacity"), read(f"{bat}/status")
    out = f"{pct}%, {status.lower()}"
    # watts: power_now where the battery has it, else current x voltage (the Framework); time from charge or energy
    uw = int(read(f"{bat}/power_now", "0")) or int(read(f"{bat}/current_now", "0")) * int(read(f"{bat}/voltage_now", "0")) // 10**6
    if uw > 0 and status in ("Discharging", "Charging"):
        out += f", {uw / 1e6:.1f} W"
        if status == "Discharging":
            now = int(read(f"{bat}/energy_now", "0")) or int(read(f"{bat}/charge_now", "0")) * int(read(f"{bat}/voltage_now", "0")) // 10**6
            if now:
                out += f", {dur(now / uw * 3600)} left"
    return out


def desktop():
    d = os.environ.get("XDG_CURRENT_DESKTOP", "")
    if "niri" not in d.lower():
        return d or None
    try:
        v = subprocess.run(["niri", "--version"], capture_output=True, text=True, timeout=2).stdout.split()
        return f"Loaf on niri {v[1]}" if len(v) > 1 else "Loaf on niri"
    except (OSError, subprocess.TimeoutExpired):
        return "Loaf on niri"


def info():
    os_rel = dict(l.split("=", 1) for l in read("/etc/os-release").splitlines() if "=" in l)
    cpus = [l.split(":", 1)[1].strip() for l in read("/proc/cpuinfo").splitlines() if l.startswith("model name")]
    mem = {l.split(":")[0]: int(l.split()[1]) for l in read("/proc/meminfo").splitlines()}
    used, total = (mem["MemTotal"] - mem["MemAvailable"]) / 2**20, mem["MemTotal"] / 2**20
    rows = [
        ("user", pwd.getpwuid(os.getuid()).pw_name),
        ("host", platform.node()),
        ("up", dur(float(read("/proc/uptime", "0").split()[0]))),
        ("system", os_rel.get("PRETTY_NAME", "Linux").strip('"')),
        ("kernel", platform.release()),
        ("desktop", desktop()),
        ("shell", os.path.basename(os.environ.get("SHELL", "")) or None),
        ("cpu", f"{cpus[0]} ({len(cpus)})" if cpus else None),
        ("memory", f"{used:.1f} / {total:.1f} GiB"),
        ("battery", battery()),
    ]
    return [(k, v) for k, v in rows if v]


def main():
    tty = os.isatty(1) and os.environ.get("NO_COLOR") is None
    bold, dim, off = ("\033[1m", "\033[2m", "\033[0m") if tty else ("", "", "")
    room = shutil.get_terminal_size().columns
    width = max(len(l) for l in CAT) + 4
    side = room >= width + 40  # wide enough for the cat next to the rows
    fit = room - (width + 2 if side else 0) - 10  # a value never wraps (a wrap would split the cat)
    rows = [f"{dim}{k:<8}{off} {v if len(v) <= fit else v[:fit - 1] + '…'}" for k, v in info()]
    if tty:  # Loaf's palette, as coloured blocks
        rows += ["", f"{dim}{'palette':<8}{off} " + "".join(
            f"\033[38;2;{int(c[1:3], 16)};{int(c[3:5], 16)};{int(c[5:], 16)}m██" + (" " if i == 4 else "")
            for i, c in enumerate(PALETTE)) + off]
    if not side:
        print("\n".join(rows))
        return
    cat = [""] * max(0, (len(rows) - len(CAT)) // 2) + CAT  # cat centred next to the rows
    for i in range(max(len(cat), len(rows))):
        left = cat[i] if i < len(cat) else ""
        print(f"  {bold}{left:<{width}}{off}{rows[i] if i < len(rows) else ''}".rstrip())


if __name__ == "__main__":
    main()
